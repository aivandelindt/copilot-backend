# Shared secret between this API and the headless CLI. This is not a GitHub token.
# Generate one with: openssl rand -hex 32
COPILOT_CONNECTION_TOKEN=

# Optional default GitHub identity for the CLI process. Per-request tokens can
# also be sent to the API as Authorization: Bearer <github-token>.
COPILOT_GITHUB_TOKEN=

# API listen address. The default is every interface.
HOST=0.0.0.0
PORT=3000

# Headless CLI address. Compose overrides this to copilot-cli:4321.
CLI_URL=localhost:4321
MODEL=gpt-5.4

SESSION_MAX_AGE_MS=86400000
CLEANUP_INTERVAL_MS=3600000
CHAT_TIMEOUT_MS=120000

# Optional bring-your-own-key provider. Leave the key blank to use GitHub Copilot auth.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
